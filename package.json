{
  "name": "anime-countdown",
  "version": "1.0.0",
  "private": true,
  "description": "Anime release countdown with native notifications",
  "scripts": {
    "dev": "node server.js",
    "cap:init": "npx cap init AnimeCountdown com.animecountdown.app",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:www": "node scripts/build-www.js",
    "cap:build": "npm run build:www && npx cap sync && npx cap copy android",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "sync:platforms": "node scripts/enrich-platforms.js"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "playwright": "^1.64.1"
  }
}
